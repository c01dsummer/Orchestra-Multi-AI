{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/pr-watch.json",
  "title": "巡检对账输出与水位线",
  "description": "校验 schema_version: 1 的对账输出和不要求 schema_version 的持久状态；快照输入不由本 schema 校验。输出条目的 repo 为 null（单仓无 repo，或缺失、非法的输入被拒收降级）或匹配 ^[!-~]+$ 的非空可见 ASCII 字符串，不得含换行。",
  "oneOf": [
    {
      "$ref": "#/$defs/output"
    },
    {
      "$ref": "#/$defs/state"
    }
  ],
  "$defs": {
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "reason"
      ],
      "properties": {
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "runs": {
      "type": "object",
      "required": [
        "in_flight",
        "completed_unreported",
        "orphaned",
        "unknown"
      ],
      "properties": {
        "in_flight": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "completed_unreported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "orphaned": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run"
          }
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "is_window_idle",
        "consecutive_idle_windows",
        "idle_window_threshold",
        "can_pause_routine"
      ],
      "properties": {
        "is_window_idle": {
          "type": "boolean"
        },
        "consecutive_idle_windows": {
          "type": "integer",
          "minimum": 0
        },
        "idle_window_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "can_pause_routine": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "runs",
        "prs",
        "window_state"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "ok",
            "idle",
            "degraded_unknown",
            "unknown",
            "attention_required"
          ]
        },
        "runs": {
          "$ref": "#/$defs/runs"
        },
        "prs": {
          "type": "object",
          "required": [
            "items",
            "unhandled_events",
            "active_open_prs_requiring_watch"
          ],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "repo",
                  "number",
                  "head_sha",
                  "comments",
                  "unhandled_events",
                  "requires_watch",
                  "action",
                  "reasons",
                  "round",
                  "idempotency_key",
                  "circuit_broken"
                ],
                "properties": {
                  "repo": {
                    "type": ["string", "null"],
                    "pattern": "^[!-~]+$",
                    "not": {"type": "string", "pattern": "[\r\n]"}
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "head_sha": {
                    "type": "string",
                    "minLength": 1
                  },
                  "comments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["event", "trusted", "body", "action"],
                      "properties": {
                        "event": {"type": "string"},
                        "trusted": {"type": "boolean"},
                        "body": {"type": "string"},
                        "action": {"enum": ["observe", "ignore_untrusted"]}
                      }
                    }
                  },
                  "unhandled_events": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "requires_watch": {
                    "type": "boolean"
                  },
                  "action": {
                    "enum": [
                      "observe",
                      "dispatch_auto_fix",
                      "idempotent_skip",
                      "circuit_breaker_escalate",
                      "blocked_unknown",
                      "dry_run_preview"
                    ]
                  },
                  "reasons": {
                    "type": "array",
                    "items": {"type": "string"}
                  },
                  "circuit_broken": {
                    "type": "boolean"
                  },
                  "round": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "idempotency_key": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "dispatch_auto_fix"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "then": {
                      "required": [
                        "round",
                        "idempotency_key"
                      ],
                      "properties": {
                        "round": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "idempotency_key": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "const": "blocked_unknown"
                        }
                      },
                      "required": ["action"]
                    },
                    "then": {
                      "properties": {
                        "requires_watch": {"const": true}
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "action": {
                          "enum": [
                            "blocked_unknown",
                            "dry_run_preview"
                          ]
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    "then": {
                      "required": [
                        "round",
                        "idempotency_key"
                      ],
                      "properties": {
                        "round": {
                          "type": "null"
                        },
                        "idempotency_key": {
                          "type": "null"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "unhandled_events": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "active_open_prs_requiring_watch": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "window_state": {
          "$ref": "#/$defs/window"
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "consecutive_idle_windows",
        "prs",
        "reported_pr_events"
      ],
      "properties": {
        "consecutive_idle_windows": {
          "type": "integer",
          "minimum": 0
        },
        "reported_pr_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prs": {
          "type": "object",
          "anyOf": [
            {
              "propertyNames": {
                "pattern": "^[1-9][0-9]*$",
                "not": {"pattern": "[\r\n]"}
              }
            },
            {
              "propertyNames": {
                "pattern": "^[!-~]+#[1-9][0-9]*$",
                "not": {"pattern": "[\r\n]"}
              }
            }
          ],
          "additionalProperties": {
            "type": "object",
            "required": [
              "round_count",
              "heads"
            ],
            "properties": {
              "round_count": {
                "type": "integer",
                "minimum": 0
              },
              "heads": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
